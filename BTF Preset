--// LOAD UI
function updateFields()
	local p = presets[selected]

	eqBox.Text = p.eq
	relicBox.Text = p.relic
	runeBox.Text = p.rune
	decorBox.Text = p.decor
	statueBox.Text = p.statue
	skillBox.Text = table.concat(p.skills, ",")
end

updateFields()

--// APPLY FUNCTION
local function applyCurrentPreset()
	local p = presets[selected]

	local skills = {}
	for v in string.gmatch(skillBox.Text, "%d+") do
		table.insert(skills, v)
	end

	switchEqEvent:FireServer(tonumber(eqBox.Text) or 1, 1)
	switchRelicEvent:FireServer(tonumber(relicBox.Text) or 1, 1)
	switchRuneEvent:FireServer(tonumber(runeBox.Text) or 1, 1)
	switchDecorEvent:FireServer(tonumber(decorBox.Text) or 1, 1)
	switchStatueEvent:FireServer(tonumber(statueBox.Text) or 1, 1)

	for i, s in ipairs(skills) do
		EquipSkillRemote:FireServer(s, i)
	end
end

